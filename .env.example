# Local environment. Copy to `.env.local` and fill in real values.
# `.env*.local` is gitignored — never commit credentials here.

# Supabase project shared with the web app. The key must be the PUBLIC
# anon/publishable key. Never use a service-role key in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Root of the existing NORTH & FORM API, INCLUDING the `/api` path.
# Endpoints are resolved relative to this, e.g. `${EXPO_PUBLIC_API_URL}/cart`.
# Production: https://northform-livid.vercel.app/api
# Local dev:   http://192.168.x.x:3000/api  (LAN IP — `localhost` is the device)
EXPO_PUBLIC_API_URL=